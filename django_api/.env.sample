# Django設定
SECRET_KEY=YOUR_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# リバースプロキシ経由でHTTPSアクセスする場合に設定（スキーム付き・カンマ区切り）
# 例: https://example.com,https://sub.example.com
CSRF_TRUSTED_ORIGINS=

# データベース設定（PostgreSQL）
# Docker Compose環境ではapp-databaseコンテナに接続
# ホストから直接pytestを実行する場合はDB_ENGINEをコメントアウトすると
# SQLiteにフォールバックする（CIと同じ構成。app-databaseはホストにポート非公開）
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kawashiro
DB_USER=kawashiro
DB_PASSWORD=kawashiro-dev
DB_HOST=app-database
DB_PORT=5432

# データベースに保存する機密情報の暗号化に使用
# 本番環境では十分にランダムな文字列を設定してください
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# Celery（非同期タスク・定期実行）
# 既定はDocker Compose内のredisコンテナ
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Style-BERT-VITS2 API（音声合成機能）
# Docker Compose内部の場合: http://sbv2-api:5000
TTS_SERVICE_URL=http://sbv2-api:5000
# TTSリクエストのタイムアウト（秒）
TTS_TIMEOUT=120

# LiteLLM Proxy（LLMゲートウェイ）
# 未設定時の既定: http://litellm-proxy:4000/v1
LITELLM_PROXY_URL=
# LLMProviderConfigでVirtual Key未設定時のフォールバックキー
LITELLM_MASTER_KEY=

# Langfuse LLMOps（トレーシング・プロンプト管理）
# セルフホスト環境の場合はBASE_URLを設定
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
# dev: 開発環境、prd: 本番環境
LANGFUSE_TRACING_ENVIRONMENT=dev
