# ============================================================
# Backup Script Settings
# ============================================================

# ------------------------------------------------------------
# Immich バックアップ設定
# ------------------------------------------------------------
# PostgreSQL設定（Immichのデータベース接続情報）
DB_HOSTNAME=immich-postgres
DB_USERNAME=immich
DB_PASSWORD=your_database_password
DB_DATABASE_NAME=immich

# Immich バックアップの OneDrive 保存先パス
IMMICH_ONEDRIVE_BACKUP_PATH=/path/to/backup/immich

# 写真データのバックアップを有効にするか（デフォルト: false）
BACKUP_DATA=false

# ------------------------------------------------------------
# Django バックアップ設定
# ------------------------------------------------------------
# Django バックアップの OneDrive 保存先パス
DJANGO_ONEDRIVE_BACKUP_PATH=/path/to/backup/django_api

# ------------------------------------------------------------
# 共通設定
# ------------------------------------------------------------
# Django API設定（OneDrive API へのアクセス用）
DJANGO_API_URL=http://django-api:8000
DJANGO_API_TOKEN=your_django_api_token

# バックアップ保持世代数（デフォルト: 7）
BACKUP_RETENTION_GENERATIONS=7

# タイムゾーン
TZ=Asia/Tokyo
