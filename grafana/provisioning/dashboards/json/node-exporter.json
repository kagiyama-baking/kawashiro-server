{
    "annotations": {
        "list": []
    },
    "description": "Node Exporterメトリクスによるホストマシン監視ダッシュボード",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "panels": [
        {
            "title": "CPU使用率",
            "type": "gauge",
            "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 60 },
                            { "color": "red", "value": 85 }
                        ]
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "targets": [
                {
                    "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                    "legendFormat": "CPU使用率",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "メモリ使用率",
            "type": "gauge",
            "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 70 },
                            { "color": "red", "value": 90 }
                        ]
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "targets": [
                {
                    "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
                    "legendFormat": "メモリ使用率",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "ディスク使用率（/）",
            "type": "gauge",
            "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 70 },
                            { "color": "red", "value": 90 }
                        ]
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "targets": [
                {
                    "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})) * 100",
                    "legendFormat": "ディスク使用率",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "システム稼働時間",
            "type": "stat",
            "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [{ "color": "green", "value": null }]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "node_time_seconds - node_boot_time_seconds",
                    "legendFormat": "稼働時間",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "CPU使用率（時系列）",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 20,
                        "showPoints": "never",
                        "stacking": { "mode": "normal" }
                    },
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "avg by (mode) (rate(node_cpu_seconds_total[5m])) * 100",
                    "legendFormat": "{{mode}}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "メモリ使用量（時系列）",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 20,
                        "showPoints": "never",
                        "stacking": { "mode": "normal" }
                    },
                    "unit": "bytes",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
                    "legendFormat": "使用中",
                    "refId": "A"
                },
                {
                    "expr": "node_memory_MemAvailable_bytes",
                    "legendFormat": "空き",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "ネットワーク帯域幅",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 10,
                        "showPoints": "never"
                    },
                    "unit": "Bps",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m])",
                    "legendFormat": "{{device}} (受信)",
                    "refId": "A"
                },
                {
                    "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m])",
                    "legendFormat": "{{device}} (送信)",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "ディスクI/O",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 10,
                        "showPoints": "never"
                    },
                    "unit": "Bps",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "rate(node_disk_read_bytes_total[5m])",
                    "legendFormat": "{{device}} (読み取り)",
                    "refId": "A"
                },
                {
                    "expr": "rate(node_disk_written_bytes_total[5m])",
                    "legendFormat": "{{device}} (書き込み)",
                    "refId": "B"
                }
            ]
        }
    ],
    "schemaVersion": 39,
    "tags": ["node-exporter", "host", "system"],
    "templating": { "list": [] },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {},
    "timezone": "Asia/Tokyo",
    "title": "3.Node Exporter",
    "uid": "node-exporter",
    "version": 1
}
