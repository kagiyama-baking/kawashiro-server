{
    "annotations": {
        "list": []
    },
    "description": "Nginx Exporterメトリクスとアクセス/エラーログによるリバースプロキシ監視ダッシュボード",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "panels": [
        {
            "title": "アクティブ接続数",
            "type": "stat",
            "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 100 },
                            { "color": "red", "value": 500 }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "nginx_connections_active",
                    "legendFormat": "アクティブ接続",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "待機中の接続数",
            "type": "stat",
            "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 50 },
                            { "color": "red", "value": 200 }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "nginx_connections_waiting",
                    "legendFormat": "待機中接続",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "総リクエスト数",
            "type": "stat",
            "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [{ "color": "blue", "value": null }]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "nginx_http_requests_total",
                    "legendFormat": "総リクエスト",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Nginx稼働状態",
            "type": "stat",
            "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "1": { "text": "UP", "color": "green" }
                            }
                        },
                        {
                            "type": "value",
                            "options": {
                                "0": { "text": "DOWN", "color": "red" }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "nginx_up",
                    "legendFormat": "Nginx状態",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "リクエスト/秒",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 20,
                        "showPoints": "never"
                    },
                    "unit": "reqps",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "rate(nginx_http_requests_total[5m])",
                    "legendFormat": "リクエスト/秒",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "接続状態（時系列）",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 10,
                        "showPoints": "never"
                    },
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "nginx_connections_active",
                    "legendFormat": "アクティブ",
                    "refId": "A"
                },
                {
                    "expr": "nginx_connections_reading",
                    "legendFormat": "読み取り中",
                    "refId": "B"
                },
                {
                    "expr": "nginx_connections_writing",
                    "legendFormat": "書き込み中",
                    "refId": "C"
                },
                {
                    "expr": "nginx_connections_waiting",
                    "legendFormat": "待機中",
                    "refId": "D"
                }
            ]
        },
        {
            "title": "接続処理数（時系列）",
            "type": "timeseries",
            "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
            "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 10,
                        "showPoints": "never"
                    },
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "tooltip": { "mode": "multi", "sort": "desc" },
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "calcs": ["mean", "max"]
                }
            },
            "targets": [
                {
                    "expr": "rate(nginx_connections_accepted[5m])",
                    "legendFormat": "受理/秒",
                    "refId": "A"
                },
                {
                    "expr": "rate(nginx_connections_handled[5m])",
                    "legendFormat": "処理/秒",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "Nginxアクセスログ",
            "type": "logs",
            "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
            "datasource": { "type": "loki", "uid": "loki-datasource" },
            "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": false
            },
            "targets": [
                {
                    "expr": "{job=\"nginx\", log_type=\"access\"}",
                    "legendFormat": "",
                    "refId": "A",
                    "queryType": "range"
                }
            ]
        },
        {
            "title": "Nginxエラーログ",
            "type": "logs",
            "gridPos": { "h": 12, "w": 24, "x": 0, "y": 34 },
            "datasource": { "type": "loki", "uid": "loki-datasource" },
            "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": false
            },
            "targets": [
                {
                    "expr": "{job=\"nginx\", log_type=\"error\"}",
                    "legendFormat": "",
                    "refId": "A",
                    "queryType": "range"
                }
            ]
        }
    ],
    "schemaVersion": 39,
    "tags": ["nginx", "reverse-proxy", "loki"],
    "templating": { "list": [] },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {},
    "timezone": "Asia/Tokyo",
    "title": "2.Reverse Proxy監視ダッシュボード",
    "uid": "nginx-dashboard",
    "version": 1
}
