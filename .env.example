# ============================================================
# Immich
# ============================================================
# PostgreSQL設定
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE_NAME=YOUR_DB_NAME

# Immichサーバー設定
PUBLIC_SERVER_URL=http://example.com  # 本番環境では実際のドメインに変更してください
IMMICH_LOG_LEVEL=verbose

# タイムゾーン
TZ=Asia/Tokyo

# ============================================================
# Django API
# ============================================================
# 接続許可  
ALLOWED_HOSTS=localhost,127.0.0.1  # カンマ区切り

# デバッグモード
DEBUG=True

# シークレットキー
SECRET_KEY=YOUR_SECRET_KEY